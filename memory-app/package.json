{
  "name": "piece-of-memory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "npm run guide:build && next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "guide:build": "node scripts/build-project-guide.mjs",
    "guide:check": "node scripts/build-project-guide.mjs --check",
    "test:guide": "node --test tests/guide.test.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "konsta": "^5.4.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@phosphor-icons/react": "^2.1.0",
    "better-sqlite3": "^12.0.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "tsx": "^4.20.0"
  }
}
