# Optional: exact externally visible origin when using your own HTTPS reverse proxy.
# MEMORY_PUBLIC_ORIGIN=https://memory.example.test

# Optional: comma-separated HTTPS API host allowlist, in addition to api.openai.com.
# Only add providers you explicitly trust. Never put a URL/path here.
# MEMORY_API_HOSTS=your-speech-provider.example

# API keys are entered in Settings and encrypted on the local server.
# Do not commit .env files or data/.
