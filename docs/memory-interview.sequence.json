{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "기억의 조각 · 이야기 확인과 저장",
    "subtitle": "텍스트 입력은 녹음·전사를 건너뛰고 수정·확인에 합류합니다. 로컬 모델은 연결된 서버에서 실행됩니다.",
    "quality_profile": "showcase",
    "animation": "none",
    "column_fit": "spread",
    "viewBox": [
      1200,
      600
    ]
  },
  "participants": [
    {
      "id": "speaker",
      "type": "external",
      "label": "사용자"
    },
    {
      "id": "interview-pwa",
      "type": "frontend",
      "label": "PWA"
    },
    {
      "id": "interview-api",
      "type": "backend",
      "label": "Next.js API"
    },
    {
      "id": "speech-service",
      "type": "backend",
      "label": "로컬 음성 서비스"
    },
    {
      "id": "turn-store",
      "type": "database",
      "label": "저장소"
    },
    {
      "id": "question-model",
      "type": "backend",
      "label": "Ollama"
    }
  ],
  "messages": [
    {
      "id": "record-stop",
      "from": "speaker",
      "to": "interview-pwa",
      "y": 160,
      "label": "녹음 종료 · 수동/침묵"
    },
    {
      "id": "audio-post",
      "from": "interview-pwa",
      "to": "interview-api",
      "y": 188,
      "label": "음성 POST"
    },
    {
      "id": "korean-stt",
      "from": "interview-api",
      "to": "speech-service",
      "y": 216,
      "label": "한국어 전사 요청"
    },
    {
      "id": "transcript-return",
      "from": "speech-service",
      "to": "interview-api",
      "y": 244,
      "label": "전사문",
      "variant": "return"
    },
    {
      "id": "review-return",
      "from": "interview-api",
      "to": "interview-pwa",
      "y": 272,
      "label": "검토할 원문",
      "variant": "return"
    },
    {
      "id": "confirm-text",
      "from": "speaker",
      "to": "interview-pwa",
      "y": 300,
      "label": "수정 · 확인"
    },
    {
      "id": "turn-post",
      "from": "interview-pwa",
      "to": "interview-api",
      "y": 328,
      "label": "확정 원문 POST"
    },
    {
      "id": "persist-turn",
      "from": "interview-api",
      "to": "turn-store",
      "y": 356,
      "label": "확정 이야기 저장",
      "variant": "emphasis"
    },
    {
      "id": "generate-question",
      "from": "interview-api",
      "to": "question-model",
      "y": 384,
      "label": "다음 질문 생성"
    },
    {
      "id": "question-result",
      "from": "question-model",
      "to": "interview-api",
      "y": 412,
      "label": "생성 결과",
      "variant": "return"
    },
    {
      "id": "persist-question",
      "from": "interview-api",
      "to": "turn-store",
      "y": 440,
      "label": "질문 또는 안내 문구 저장"
    },
    {
      "id": "turn-response",
      "from": "interview-api",
      "to": "interview-pwa",
      "y": 468,
      "label": "질문/안내 반환",
      "variant": "return"
    },
    {
      "id": "postcard-display",
      "from": "interview-pwa",
      "to": "speaker",
      "y": 496,
      "label": "엽서 화면 표시",
      "variant": "return"
    }
  ]
}
